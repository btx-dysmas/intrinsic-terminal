# Copy to .env.local for local development. On Vercel, add the same keys under
# Project Settings -> Environment Variables.

# Required by the SEC for automated requests: your name and a contact email.
SEC_USER_AGENT=Your Name you@example.com

# Free key from https://fred.stlouisfed.org/docs/api/api_key.html (macro dashboard, risk-free rate).
FRED_API_KEY=
